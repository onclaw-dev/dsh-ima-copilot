{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "baseContract", "baseTag", "providerInjection", "tags"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseContract": { "const": "IMA-BASE-1" },
    "baseTag": { "type": "string" },
    "providerInjection": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "deniedRuntimeIdentities": { "type": "array" },
    "tags": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["tag", "contract", "interfaceFamily", "adapter"] } }
  },
  "additionalProperties": false
}
